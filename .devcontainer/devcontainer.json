{
    "name": "fingerprint-analysis",
    "image": "fingerprint-analysis:latest",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "runArgs": [
        "--gpus", "all",
        "--init",
        "--user", "root",
        "--shm-size", "16g"
    ],
    "mounts": [
        "source=/opt/data/FP_Real,target=/data/real,type=bind,readonly",
        "source=/opt/data/FP_Synth,target=/data/synthetic,type=bind,readonly"
    ],
    "postCreateCommand": "mkdir -p /workspace/outputs /workspace/splits /workspace/configs && chmod -R 777 /workspace/outputs /workspace/splits /workspace/configs",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-azuretools.vscode-docker",
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ],
            "settings": {
		"python.defaultInterpreterPath": "/usr/bin/python3",
                "files.watcherExclude": {
                    "**/data/**": true,
                    "**/outputs/**": true,
                    "**/splits/**": true
                },
                "files.exclude": {
                    "**/data/**": true
                }
            }
        }
    }
}
